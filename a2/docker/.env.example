# Copy to docker/.env (git-ignored) and fill in. docker compose loads it automatically.
AWS_PROFILE=
# S3 prefix of the BonesSeedA2 soma_uniform CSVs (read-only source), e.g. s3://<bucket>/datasets/BonesSeedA2/soma_uniform
A2_S3_URI=
WANDB_API_KEY=
WANDB_MODE=
# host uid/gid the container runs as (id -u / id -g)
A2_UID=
A2_GID=
